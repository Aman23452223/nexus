# NEXUS env template — NEVER commit real tokens.
# Copy to .env and fill locally. All secrets load from env only.
NEXUS_WORKSPACE=personal
NEXUS_DATA_DIR=./nexus_data
NEXUS_DRY_RUN=false
# Optional connectors (leave empty until you configure via `vercel login` / `gh auth login`):
# GITHUB_TOKEN=
# VERCEL_TOKEN=
